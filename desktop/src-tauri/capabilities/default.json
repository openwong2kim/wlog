{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "wlog desktop: allow spawning the bundled wlog sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "wlog", "sidecar": true, "args": true }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "wlog", "sidecar": true, "args": true }]
    }
  ]
}
